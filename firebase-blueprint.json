{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for Clients, Partners, and Admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["CUSTOMER", "PARTNER_OWNER", "PARTNER_STAFF", "ADMIN", "SALES_ADMIN"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "SUSPENDED", "PENDING_VERIFICATION"] },
        "partnerId": { "type": "string", "maxLength": 64 },
        "partnerSlug": { "type": "string", "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 256 },
        "wholesaleApprovalStatus": { "type": "string", "enum": ["NONE", "PENDING", "APPROVED", "DECLINED"] },
        "mfaEnabled": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 64 },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Clinical or studio partner organization",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "partnerId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 256 },
        "businessName": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 128 },
        "contactPerson": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 2048 },
        "logoUrl": { "type": "string", "maxLength": 1024 },
        "website": { "type": "string", "maxLength": 512 },
        "category": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 512 },
        "location": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["NEW", "UNDER REVIEW", "APPROVED", "DECLINED", "NEEDS INFORMATION", "PENDING", "SUSPENDED", "REJECTED"] },
        "commissionRate": { "type": "number" },
        "memberDiscountRate": { "type": "number" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "preferredCategories": { "type": "array" },
        "adminNotes": { "type": "string", "maxLength": 2048 },
        "landingPageVisible": { "type": "boolean" },
        "landingPageHeadline": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["partnerId", "name", "slug", "email", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Peptide formulation or clinical wellness product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["metabolic", "cellular", "recovery", "longevity", "stacks"] },
        "categoryLabel": { "type": "string", "maxLength": 128 },
        "shortDescription": { "type": "string", "maxLength": 512 },
        "description": { "type": "string", "maxLength": 4096 },
        "price": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "stockQuantity": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "UNAVAILABLE", "DISABLED", "DRAFT", "ARCHIVED", "OUT_OF_STOCK"] },
        "featured": { "type": "boolean" },
        "strengths": { "type": "array" },
        "wholesaleStrengths": { "type": "array" },
        "lotNumber": { "type": "string", "maxLength": 64 },
        "purity": { "type": "string", "maxLength": 64 },
        "disclosures": { "type": "string", "maxLength": 2048 },
        "educationalMaterial": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "slug", "category", "price", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with partner attribution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "volumeDiscount": { "type": "number" },
        "partnerDiscount": { "type": "number" },
        "shipping": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "PROCESSING", "SHIPPED", "COMPLETED", "CANCELLED", "REFUNDED"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "AUTHORIZED", "PAID", "FAILED", "REFUNDED"] },
        "partnerId": { "type": "string", "maxLength": 64 },
        "partnerSlug": { "type": "string", "maxLength": 128 },
        "partnerName": { "type": "string", "maxLength": 256 },
        "referralSource": { "type": "string", "maxLength": 256 },
        "partnerCommission": { "type": "number" },
        "commissionStatus": { "type": "string", "enum": ["NONE", "PENDING", "APPROVED", "PAID", "CANCELLED"] },
        "trackingNumber": { "type": "string", "maxLength": 128 },
        "coldChainLogged": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["orderNumber", "customerName", "customerEmail", "items", "total", "status", "createdAt"]
    },
    "PartnerEarning": {
      "title": "PartnerEarning",
      "description": "Auditable commission ledger entry for partner sales",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "partnerId": { "type": "string", "maxLength": 64 },
        "partnerSlug": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 64 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerName": { "type": "string", "maxLength": 128 },
        "grossSales": { "type": "number" },
        "eligibleSales": { "type": "number" },
        "commissionRate": { "type": "number" },
        "earningAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "PAID", "CANCELLED"] },
        "payoutBatchId": { "type": "string", "maxLength": 64 },
        "paidAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["partnerId", "orderId", "grossSales", "earningAmount", "status", "createdAt"]
    },
    "WellnessProgram": {
      "title": "WellnessProgram",
      "description": "Physician-guided wellness protocol program",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 128 },
        "duration": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "tag": { "type": "string", "maxLength": 64 },
        "shortDescription": { "type": "string", "maxLength": 512 },
        "fullDescription": { "type": "string", "maxLength": 4096 },
        "priceMonthly": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 524288 },
        "eligibility": { "type": "string", "maxLength": 1024 },
        "ctaLabel": { "type": "string", "maxLength": 128 },
        "ctaLink": { "type": "string", "maxLength": 512 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "features": { "type": "array" },
        "status": { "type": "string", "enum": ["ACTIVE", "DRAFT", "ARCHIVED"] },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "slug", "priceMonthly", "status", "createdAt"]
    },
    "EducationalArticle": {
      "title": "EducationalArticle",
      "description": "Clinical protocol guide and educational resource",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "readTime": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 1024 },
        "content": { "type": "string", "maxLength": 16384 },
        "imageUrl": { "type": "string", "maxLength": 524288 },
        "author": { "type": "string", "maxLength": 128 },
        "tags": { "type": "array" },
        "seoTitle": { "type": "string", "maxLength": 256 },
        "seoDescription": { "type": "string", "maxLength": 512 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT", "ARCHIVED"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "slug", "category", "status", "createdAt"]
    },
    "FAQ": {
      "title": "FAQ",
      "description": "Frequently asked question and answer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "question": { "type": "string", "maxLength": 512 },
        "answer": { "type": "string", "maxLength": 4096 },
        "category": { "type": "string", "maxLength": 64 },
        "orderIndex": { "type": "number" },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["question", "answer"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client or physician testimonial",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 128 },
        "organization": { "type": "string", "maxLength": 128 },
        "quote": { "type": "string", "maxLength": 2048 },
        "rating": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 524288 },
        "category": { "type": "string", "maxLength": 64 },
        "consentConfirmed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT"] },
        "verified": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "quote", "rating"]
    },
    "CmsPageContent": {
      "title": "CmsPageContent",
      "description": "Editable storefront, Our Approach, promotion banner, and legal pages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 512 },
        "category": { "type": "string", "enum": ["Legal & Compliance", "Storefront & Approach", "Promotions", "Custom Page"] },
        "body": { "type": "string", "maxLength": 32768 },
        "ctaLabel": { "type": "string", "maxLength": 128 },
        "ctaPath": { "type": "string", "maxLength": 256 },
        "seoTitle": { "type": "string", "maxLength": 256 },
        "seoDescription": { "type": "string", "maxLength": 512 },
        "sections": { "type": "array" },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["slug", "title", "category", "body", "status", "createdAt", "updatedAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Admin-managed media library imagery for products, articles, and branding",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 655360 },
        "category": { "type": "string", "enum": ["Brand & Hero", "Products", "Learn Studio", "Uploaded"] },
        "mimeType": { "type": "string", "maxLength": 64 },
        "isBuiltIn": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "url", "category", "createdAt"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "Persistent transactional event notifications for partner onboarding and account updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "eventType": { "type": "string", "enum": ["PARTNER_APPLICATION_RECEIVED", "PARTNER_APPLICATION_APPROVED", "PARTNER_STATUS_UPDATED", "PARTNER_ACCOUNT_CREATED", "ACCOUNT_SECURITY_UPDATED"] },
        "recipientEmail": { "type": "string", "maxLength": 256 },
        "recipientName": { "type": "string", "maxLength": 128 },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "partnerId": { "type": "string", "maxLength": 64 },
        "subject": { "type": "string", "maxLength": 256 },
        "body": { "type": "string", "maxLength": 2048 },
        "channel": { "type": "string", "enum": ["EMAIL_WEBHOOK", "IN_APP_LEDGER"] },
        "deliveryStatus": { "type": "string", "enum": ["SENT", "LOGGED", "FAILED"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["eventType", "recipientEmail", "subject", "body", "channel", "deliveryStatus", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative and authentication security audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 64 },
        "resource": { "type": "string", "maxLength": 64 },
        "resourceId": { "type": "string", "maxLength": 128 },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["action", "resource", "timestamp"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Support, clinical, or partnership intake inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 4096 },
        "source": { "type": "string", "enum": ["contact_page", "about_page", "portal"] },
        "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "RESOLVED"] },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "email", "department", "message", "status", "createdAt"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Privacy-conscious user journey and conversion event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "eventType": { "type": "string", "enum": ["page_view", "product_view", "partner_visit", "add_to_cart", "checkout_completed", "search"] },
        "path": { "type": "string", "maxLength": 256 },
        "label": { "type": "string", "maxLength": 256 },
        "partnerSlug": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "value": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["eventType", "path", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and RBAC claims for Clients, Partners, and Admins"
    },
    "/partners/{partnerId}": {
      "schema": { "$ref": "#/entities/Partner" },
      "description": "Registered partner accounts and clinical directories"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog of pharmaceutical-grade peptide and wellness products"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchase orders and referral attribution records"
    },
    "/partner_earnings/{earningId}": {
      "schema": { "$ref": "#/entities/PartnerEarning" },
      "description": "Auditable commission ledger tracking partner payouts"
    },
    "/wellness_programs/{programId}": {
      "schema": { "$ref": "#/entities/WellnessProgram" },
      "description": "Physician-supervised guided clinical protocols"
    },
    "/educational_articles/{articleId}": {
      "schema": { "$ref": "#/entities/EducationalArticle" },
      "description": "Peer-reviewed guides, cold chain protocols, and research articles"
    },
    "/faqs/{faqId}": {
      "schema": { "$ref": "#/entities/FAQ" },
      "description": "Frequently asked questions"
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Physician and patient clinical testimonials"
    },
    "/cms_pages/{pageId}": {
      "schema": { "$ref": "#/entities/CmsPageContent" },
      "description": "Editable storefront, Our Approach, promotions, and legal pages"
    },
    "/media_assets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Uploaded and managed media assets for CMS and catalog"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "Transactional email and account security notification logs"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System and security audit log entries"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Customer and clinic inquiries submitted via contact forms"
    },
    "/analytics_events/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Privacy-conscious conversion and partner referral analytics"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muchuikelvin423@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Partners collection
    match /partners/{partnerId} {
      allow read: if true; // Public can see approved partner landing pages
      allow create: if true; // Prospective partners can submit onboarding application
      allow update: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // Products catalog
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isAdmin() || true; // In dev/demo admin CMS can manage products
    }
    
    // Wellness Programs
    match /wellness_programs/{programId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
    
    // Orders
    match /orders/{orderId} {
      allow read: if true; // Customers & partners track orders
      allow create: if true; // Guest or authenticated checkout
      allow update: if true; // Status updates by admin or processing
      allow delete: if isAdmin();
    }
    
    // Partner Earnings
    match /partner_earnings/{earningId} {
      allow read: if true;
      allow write: if true; // Calculated upon checkout & manageable in admin
    }
    
    // Educational Articles
    match /educational_articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }
    
    // FAQs & Testimonials
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

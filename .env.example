# WHOLE HARBOR WELLNESS - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS

# App Host URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://wh_user:wh_password@localhost:5432/whole_harbor_wellness?schema=public"

# Authentication & Session Security
AUTH_SECRET="your-32-byte-hex-or-base64-random-auth-secret"
AUTH_SESSION_EXPIRY_DAYS=30
AUTH_COOKIE_NAME="wh_session_token"

# Partner Ecosystem Configuration
DEFAULT_ATTRIBUTION_WINDOW_DAYS=30
DEFAULT_PARTNER_COMMISSION_RATE=0.25
DEFAULT_MEMBER_DISCOUNT_RATE=0.15

# Integration Service Placeholders (For Future Modules)
EMAIL_SERVER="smtp://user:pass@smtp.provider.com:587"
EMAIL_FROM="Whole Harbor Wellness <concierge@wholeharborwellness.com>"
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="whole-harbor-media"
PAYMENT_PROVIDER="stripe"
ANALYTICS_ID="G-XXXXXXXXXX"

# Gemini AI Platform (AI Studio injected)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
